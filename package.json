{
  "name": "stacked-tasks",
  "version": "0.1.0",
  "description": "Move tasks and subtasks between daily notes, rebuilding their parent context in the destination.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "install-local": "node scripts/install-local.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tasks",
    "daily-notes"
  ],
  "author": "lowkeysam",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.2",
    "moment": "^2.30.1",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
